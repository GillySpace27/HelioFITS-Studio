PUNCHStudio-*.zip
PUNCHStudio-Guide.pdf
PUNCHStudio-Guide.md
HFStudio-*.dmg
HFStudio-*.zip
HFStudio-Guide.pdf
HFStudio-Guide.md
__pycache__/

# scratch dirs and files the package/notarize/icon steps create
.release_stage/
.app_stage/
.runtime/
.app_out/
.dmg_stage/
.PUNCHStudio.iconset/
.heliofits_iris.iconset/
.appicon/
.entitlements.plist
.app_smoke.log
.cs.err
.np.err
.notarize-run.json
.notarize-run-intel.json

# guide content backups
guide_content.bak.json
guide_content.prepanel.json

# run logs, in-progress build copies, macOS cruft
*.log
*.bak
.DS_Store
.jdk-x64/

# notarization in flight and Apple's answers (deploy_release.sh notarize / notarize-resume).
# Kept on disk; no script removes them; the next submission for the same arch replaces them.
.notarize-pending.json
.notarize-pending-intel.json
.notarize-submit.json
.notarize-submit.err
.notarize-info.json
.notarize-info.err
.notarize-log-*.json
